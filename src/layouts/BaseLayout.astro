---
import Navbar from '../components/Navbar.astro';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · OpenLink` : 'OpenLink — Architecture Portfolio';
const metaDesc = description ?? 'A minimalist architecture and design portfolio.';
---
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />

    <!-- Archival typeface: use system stack + Noto Serif SC for CJK -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Noto+Serif+SC:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- 主题初始化（防闪烁）：必须在首帧渲染前按 localStorage 设置 dark 类 -->
    <ThemeHead />

    <style is:global>
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 22vh; /* 目录锚点跳转避让吸顶元素 */
      }
      /* ─── Reset ───────────────────────────────────── */
      *, *::before, *::after { box-sizing: border-box; }

      /* ─── Design tokens ──────────────────────────── */
      :root {
        --c-bg:       #f8f7f4;   /* warm off-white, like tracing paper */
        --c-ink:      #111111;
        --c-mid:      #666666;
        --c-rule:     #d0cfc9;   /* hairline rule colour */
        --c-hover:    #888888;
        --c-img-bg:   #f0efec;   /* letterbox behind full-width drawings */

        /* 左上角主题按钮安全区 = 按钮右缘 48px（left-6 24px + 直径 24px）+ 最小间距 12px = 60px。
           视口左缘空隙小于该值时，左侧内容用 calc 连续避让（与 Herschel 同款参数，见 .site-main / .nav-inner） */
        --toggle-safe: 60px;

        --ff-serif:   'Noto Serif SC', 'Georgia', serif;
        --ff-caps:    'IM Fell English SC', serif;
        /* 编程等宽字体栈（参考 Gemini / Cloud Code）；中文注释回落到黑体，避免宋体 */
        --ff-mono:    'JetBrains Mono', 'SF Mono', 'Menlo', 'Consolas', 'Cascadia Mono', 'Roboto Mono', 'Courier New', ui-monospace, 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', monospace;

        --fs-xs:      7.5pt;    /* archival caption */
        --fs-sm:      9pt;      /* metadata */
        --fs-body:    10.5pt;   /* prose */
        --fs-h3:      12.5pt;
        --fs-h2:      13.5pt;
        --fs-h1:      17pt;

        --lh-tight:   1.3;
        --lh-body:    1.75;

        /* 容器宽度与 Herschel max-w-7xl（1280px）一致，保证三栏骨架中正文列宽度相同 */
        --max-w:      1280px;
        --pad-x:      2rem;
      }

      /* ─── 黑白模式（dark class 切换，localStorage 记忆）─── */
      html.dark {
        --c-bg:       #000000;   /* pure black */
        --c-ink:      #e8e5dd;
        --c-mid:      #9d9a90;
        --c-rule:     #3a3a3a;
        --c-hover:    #cfcbc0;
        --c-img-bg:   #1a1a1a;
      }

      /* ─── Base ───────────────────────────────────── */
      body {
        margin: 0;
        background: var(--c-bg);
        color: var(--c-ink);
        font-family: var(--ff-serif);
        font-size: var(--fs-body);
        line-height: var(--lh-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.18s ease;
      }
      a:hover { color: var(--c-hover); }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      /*
        内容区：居中容器。左侧保留 var(--pad-x) 基础留白；
        当视口左缘空隙小于左上角主题按钮的安全区（--toggle-safe）时，
        连续计算补足 padding-left，使内容始终与按钮保持 ≥12px 间距（避退）。
      */
      .site-main {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 var(--pad-x) 6rem;
        /* 避退（Herschel 同款参数）：wordmark/正文左缘 ≥ 按钮右缘 48px + 间距 12px = 60px */
        padding-left: max(
          var(--pad-x),
          calc(var(--toggle-safe) - (100vw - min(100vw, var(--max-w))) / 2)
        );
      }

      /* ─── Prose (markdown body) ────────────────────
         基础排版（正文 1rem/1.75、标题档位、列表/引用/表格）由
         @tailwindcss/typography 提供；这里仅保留 OpenLink 的字体与建筑感细节，
         字号字重体系借鉴 Herschel。 */
      .prose {
        max-width: none;
      }
      .prose h1, .prose h2, .prose h3 {
        font-family: var(--ff-caps);
        font-weight: 400;
        letter-spacing: 0.04em;
      }
      .prose h3 {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--c-mid);
      }
      .prose p {
        text-align: justify;
        hyphens: auto;
      }
      /* 四级标题（####）用作代码块文件名标注：不加任何标题样式，与正文一致 */
      .prose h4 {
        font-family: inherit;
        font-size: inherit;
        font-weight: 400;
        line-height: inherit;
        letter-spacing: normal;
        text-transform: none;
        color: inherit;
        margin: 0 0 1.5rem;
        text-align: justify;
        hyphens: auto;
      }

      /* 规范普通列表在正文里的建筑感留白，防止列表顶格无缩进 */
      .prose ul {
        padding-left: 1.5rem;
        margin-bottom: 2rem;
      }
      .prose li {
        margin-bottom: 0.5rem;
      }

      /* Full-width architectural drawings with generous breathing room */
      .prose img {
        width: 100%;
        height: auto;
        margin: 3.5rem 0;
        background: var(--c-img-bg);
      }
      /* 视频与正文图片同宽，高度跟随真实比例自适应，不产生黑边 */
      .prose video {
        width: 100%;
        height: auto;
        display: block;
        margin: 3.5rem 0;
        background: #111;
        object-fit: cover;
      }
      /* 该视频文件左右各带 96px 黑边（画面实际为 2328x1080），显示时裁掉 */
      .prose video[src*="%E8%A1%A8%E7%9A%AE%E8%82%8C%E7%90%86"] {
        aspect-ratio: 97 / 45;
      }

      /*
        Caption-like text under a drawing: when a paragraph mixes an image
        with following text (marked .has-caption by the page script), or a
        gallery slider is followed by a text paragraph, pull the text closer
        so the description reads as attached to its own image.
      */
      .prose p.has-caption > img {
        margin-bottom: 0.75rem;
      }
      .prose .gallery-slider:has(+ p) {
        margin-bottom: 0.75rem;
      }

      /* 
        ✨ 安全优化：仅在特定场景下隐藏渲染。
        为了防微杜渐，不直接硬编码干掉 first-of-type，
        让你的设计意图列表能够畅通无阻地被用户看到。
      */
      .prose .hide-metadata {
        display: none;
      }

      /* ─── 代码块：限高滚动（滚动条隐藏）+ 圆角 + 下载/复制 ─ */
      .prose pre {
        max-width: 100%;
        max-height: 300px;
        overflow-y: auto;
        overflow-x: auto;
        border-radius: 8px;
        /* 隐藏滚动条：四角保持完整圆角；滚动时由系统 overlay 短暂提示（Mac 触控板） */
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .prose pre::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
      }
      .prose pre code {
        display: block;
        white-space: pre;
        overflow-x: auto;
        font-family: var(--ff-mono);
      }
      /* 外层包裹：按钮固定在此，不随代码滚动 */
      .prose .code-wrap {
        position: relative;
      }
      /* 右上角操作按钮：透明图标，常驻显示 */
      .prose .code-wrap .code-actions {
        position: absolute;
        top: 8px;
        right: 8px;
        display: flex;
        gap: 8px;
        z-index: 5;
      }
      .prose .code-wrap .code-actions button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        padding: 0;
        border: none;
        background: transparent;
        color: rgba(255, 255, 255, 0.65);
        cursor: pointer;
        opacity: 0.9;
        transition: color 0.15s, opacity 0.15s;
      }
      .prose .code-wrap .code-actions button:hover {
        color: #ffffff;
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <ThemeToggle />
    <Navbar />
    <main class="site-main">
      <slot />
    </main>
  </body>
  <script>
    // 代码块：右上角下载 / 复制按钮（限高滚动由 CSS 控制）
    function initCodeBlocks() {
      const langExt = {
        c: 'c', 'c#': 'cs', csharp: 'cs', cs: 'cs', 'cs-csharp': 'cs',
        js: 'js', javascript: 'js', ts: 'ts', typescript: 'ts',
        py: 'py', python: 'py', sh: 'sh', bash: 'sh', shell: 'sh',
        json: 'json', html: 'html', css: 'css', md: 'md', markdown: 'md',
        yaml: 'yml', yml: 'yml', xml: 'xml', sql: 'sql', java: 'java',
        go: 'go', rust: 'rs', rb: 'rb', ruby: 'rb', php: 'php',
        ps1: 'ps1', powershell: 'ps1', txt: 'txt'
      };
      const svgDownload =
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
      const svgCopy =
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

      // 代码块前的四级标题（####）即下载文件名；找不到四级标题时回退到最近的标题/说明文字
      function getCodeName(wrap) {
        let name = 'code';
        let el = wrap.previousElementSibling;
        while (el && /^(H[1-6]|P)$/i.test(el.tagName)) {
          const t = (el.textContent || '').trim();
          if (t && (el.tagName === 'H4' || name === 'code')) {
            name = t
              .replace(/[\\/:*?"<>|\u0000-\u001f]+/g, '-')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-+|-+$/g, '') || name;
            if (el.tagName === 'H4') break;
          }
          el = el.previousElementSibling;
        }
        return name;
      }

      document.querySelectorAll('.prose pre').forEach((pre) => {
        // 包一层外层容器：按钮固定在容器右上角，代码滚动时不跟着移动
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const actions = document.createElement('div');
        actions.className = 'code-actions';

        // 下载
        const dlBtn = document.createElement('button');
        dlBtn.type = 'button';
        dlBtn.title = '下载代码';
        dlBtn.innerHTML = svgDownload;
        dlBtn.addEventListener('click', () => {
          const lang = (pre.getAttribute('data-language') || '').toLowerCase();
          const ext = langExt[lang] || 'txt';
          const base = getCodeName(wrap);
          const blob = new Blob([pre.innerText], { type: 'text/plain;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = base + '.' + ext;
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
        });
        actions.appendChild(dlBtn);

        // 复制
        const cpBtn = document.createElement('button');
        cpBtn.type = 'button';
        cpBtn.title = '复制代码';
        cpBtn.innerHTML = svgCopy;
        cpBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            cpBtn.title = '已复制';
            setTimeout(() => (cpBtn.title = '复制代码'), 1600);
          } catch {
            cpBtn.title = '复制失败';
          }
        });
        actions.appendChild(cpBtn);

        wrap.appendChild(actions);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCodeBlocks);
    } else {
      initCodeBlocks();
    }
  </script>
</html>
