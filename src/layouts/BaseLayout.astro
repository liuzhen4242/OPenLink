---
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · OpenLink` : 'OpenLink — Architecture Portfolio';
const metaDesc = description ?? 'A minimalist architecture and design portfolio.';
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDesc} />

    <!-- Archival typeface: use system stack + Noto Serif SC for CJK -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Noto+Serif+SC:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ─── Reset ───────────────────────────────────── */
      *, *::before, *::after { box-sizing: border-box; }

      /* ─── Design tokens ──────────────────────────── */
      :root {
        --c-bg:       #f8f7f4;   /* warm off-white, like tracing paper */
        --c-ink:      #111111;
        --c-mid:      #666666;
        --c-rule:     #d0cfc9;   /* hairline rule colour */
        --c-hover:    #888888;

        --ff-serif:   'Noto Serif SC', 'Georgia', serif;
        --ff-caps:    'IM Fell English SC', serif;
        /* 编程等宽字体栈（参考 Gemini / Cloud Code）；中文注释回落到黑体，避免宋体 */
        --ff-mono:    'JetBrains Mono', 'SF Mono', 'Menlo', 'Consolas', 'Cascadia Mono', 'Roboto Mono', 'Courier New', ui-monospace, 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', monospace;

        --fs-xs:      7.5pt;    /* archival caption */
        --fs-sm:      9pt;      /* metadata */
        --fs-body:    10.5pt;   /* prose */
        --fs-h3:      12.5pt;
        --fs-h2:      13.5pt;
        --fs-h1:      17pt;

        --lh-tight:   1.3;
        --lh-body:    1.75;

        --max-w:      1100px;
        --pad-x:      2rem;
      }

      /* ─── Base ───────────────────────────────────── */
      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--c-bg);
        color: var(--c-ink);
        font-family: var(--ff-serif);
        font-size: var(--fs-body);
        line-height: var(--lh-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.18s ease;
      }
      a:hover { color: var(--c-hover); }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      /* ─── Prose (markdown body) ──────────────────── */
      .prose {
        font-size: var(--fs-body);
        line-height: var(--lh-body);
        color: #1a1a1a;
      }
      .prose h1, .prose h2, .prose h3 {
        font-family: var(--ff-caps);
        font-weight: 400;
        letter-spacing: 0.04em;
        margin-top: 3rem;
        margin-bottom: 1.25rem;
      }
      .prose h3 {
        font-size: var(--fs-h3);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--c-mid);
      }
      .prose p {
        margin: 0 0 1.5rem;
        text-align: justify;
        hyphens: auto;
      }
      /* 四级标题（####）用作代码块文件名标注：不加任何标题样式，与正文一致 */
      .prose h4 {
        font-family: inherit;
        font-size: inherit;
        font-weight: 400;
        line-height: inherit;
        letter-spacing: normal;
        text-transform: none;
        color: inherit;
        margin: 0 0 1.5rem;
        text-align: justify;
        hyphens: auto;
      }

      /* 规范普通列表在正文里的建筑感留白，防止列表顶格无缩进 */
      .prose ul {
        padding-left: 1.5rem;
        margin-bottom: 2rem;
      }
      .prose li {
        margin-bottom: 0.5rem;
      }

      /* Full-width architectural drawings with generous breathing room */
      .prose img {
        width: 100%;
        height: auto;
        margin: 3.5rem 0;
        background: #f0efec;
      }

      /*
        Caption-like text under a drawing: when a paragraph mixes an image
        with following text (marked .has-caption by the page script), or a
        gallery slider is followed by a text paragraph, pull the text closer
        so the description reads as attached to its own image.
      */
      .prose p.has-caption > img {
        margin-bottom: 0.75rem;
      }
      .prose .gallery-slider:has(+ p) {
        margin-bottom: 0.75rem;
      }

      /* 
        ✨ 安全优化：仅在特定场景下隐藏渲染。
        为了防微杜渐，不直接硬编码干掉 first-of-type，
        让你的设计意图列表能够畅通无阻地被用户看到。
      */
      .prose .hide-metadata {
        display: none;
      }

      /* ─── 代码块：限高滚动（滚动条隐藏）+ 圆角 + 下载/复制 ─ */
      .prose pre {
        max-width: 100%;
        max-height: 300px;
        overflow-y: auto;
        overflow-x: auto;
        border-radius: 8px;
        /* 隐藏滚动条：四角保持完整圆角；滚动时由系统 overlay 短暂提示（Mac 触控板） */
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      .prose pre::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
      }
      .prose pre code {
        display: block;
        white-space: pre;
        overflow-x: auto;
        font-family: var(--ff-mono);
      }
      /* 外层包裹：按钮固定在此，不随代码滚动 */
      .prose .code-wrap {
        position: relative;
      }
      /* 右上角操作按钮：透明图标，常驻显示 */
      .prose .code-wrap .code-actions {
        position: absolute;
        top: 8px;
        right: 8px;
        display: flex;
        gap: 8px;
        z-index: 5;
      }
      .prose .code-wrap .code-actions button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        padding: 0;
        border: none;
        background: transparent;
        color: rgba(255, 255, 255, 0.65);
        cursor: pointer;
        opacity: 0.9;
        transition: color 0.15s, opacity 0.15s;
      }
      .prose .code-wrap .code-actions button:hover {
        color: #ffffff;
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <Navbar />
    <main style={`max-width: var(--max-w); margin: 0 auto; padding: 0 var(--pad-x) 6rem;`}>
      <slot />
    </main>
  </body>
  <script>
    // 代码块：右上角下载 / 复制按钮（限高滚动由 CSS 控制）
    function initCodeBlocks() {
      const langExt = {
        c: 'c', 'c#': 'cs', csharp: 'cs', cs: 'cs', 'cs-csharp': 'cs',
        js: 'js', javascript: 'js', ts: 'ts', typescript: 'ts',
        py: 'py', python: 'py', sh: 'sh', bash: 'sh', shell: 'sh',
        json: 'json', html: 'html', css: 'css', md: 'md', markdown: 'md',
        yaml: 'yml', yml: 'yml', xml: 'xml', sql: 'sql', java: 'java',
        go: 'go', rust: 'rs', rb: 'rb', ruby: 'rb', php: 'php',
        ps1: 'ps1', powershell: 'ps1', txt: 'txt'
      };
      const svgDownload =
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>';
      const svgCopy =
        '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

      // 代码块前的四级标题（####）即下载文件名；找不到四级标题时回退到最近的标题/说明文字
      function getCodeName(wrap) {
        let name = 'code';
        let el = wrap.previousElementSibling;
        while (el && /^(H[1-6]|P)$/i.test(el.tagName)) {
          const t = (el.textContent || '').trim();
          if (t && (el.tagName === 'H4' || name === 'code')) {
            name = t
              .replace(/[\\/:*?"<>|\u0000-\u001f]+/g, '-')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-+|-+$/g, '') || name;
            if (el.tagName === 'H4') break;
          }
          el = el.previousElementSibling;
        }
        return name;
      }

      document.querySelectorAll('.prose pre').forEach((pre) => {
        // 包一层外层容器：按钮固定在容器右上角，代码滚动时不跟着移动
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);

        const actions = document.createElement('div');
        actions.className = 'code-actions';

        // 下载
        const dlBtn = document.createElement('button');
        dlBtn.type = 'button';
        dlBtn.title = '下载代码';
        dlBtn.innerHTML = svgDownload;
        dlBtn.addEventListener('click', () => {
          const lang = (pre.getAttribute('data-language') || '').toLowerCase();
          const ext = langExt[lang] || 'txt';
          const base = getCodeName(wrap);
          const blob = new Blob([pre.innerText], { type: 'text/plain;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = base + '.' + ext;
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
        });
        actions.appendChild(dlBtn);

        // 复制
        const cpBtn = document.createElement('button');
        cpBtn.type = 'button';
        cpBtn.title = '复制代码';
        cpBtn.innerHTML = svgCopy;
        cpBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            cpBtn.title = '已复制';
            setTimeout(() => (cpBtn.title = '复制代码'), 1600);
          } catch {
            cpBtn.title = '复制失败';
          }
        });
        actions.appendChild(cpBtn);

        wrap.appendChild(actions);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCodeBlocks);
    } else {
      initCodeBlocks();
    }
  </script>
</html>
