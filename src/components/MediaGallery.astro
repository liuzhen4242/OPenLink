---
// Shared client behavior for blog/project article pages:
// gallery slider auto-cycling + PhotoSwipe image lightbox.
import 'photoswipe/style.css';
---

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 等图片真正解码、可绘制后再切换，避免切换瞬间空白/半渲染闪烁
    function whenSettled(img) {
      if (typeof img.decode === 'function') {
        return img.decode().catch(() => {});
      }
      if (img.complete) return Promise.resolve();
      return new Promise((resolve) => {
        img.addEventListener('load', resolve, { once: true });
        img.addEventListener('error', resolve, { once: true });
      });
    }

    document.querySelectorAll('.gallery-slider').forEach((wrapper) => {
      const imgs = Array.from(wrapper.querySelectorAll('img'));
      if (imgs.length === 0) return;

      if (imgs.length === 1) {
        imgs[0].classList.add('is-active');
        return;
      }

      let index = imgs.findIndex((img) => img.classList.contains('is-active'));
      if (index < 0) index = 0;
      let playing = true;

      function show(i) {
        imgs.forEach((img, j) => img.classList.toggle('is-active', j === i));
      }

      // 每轮只等下一张就绪，上限 8s，慢图/坏图不会卡死轮播
      async function tick() {
        if (playing) {
          const nextIndex = (index + 1) % imgs.length;
          await Promise.race([
            whenSettled(imgs[nextIndex]),
            new Promise((resolve) => window.setTimeout(resolve, 8000)),
          ]);
          if (playing) {
            index = nextIndex;
            show(index);
          }
        }
        window.setTimeout(tick, 3000);
      }

      show(index);
      window.setTimeout(tick, 3000);

      wrapper.addEventListener('mouseenter', () => {
        playing = false;
      });
      wrapper.addEventListener('mouseleave', () => {
        playing = true;
      });
    });
  });
</script>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = new PhotoSwipeLightbox({
      gallery: '.prose',
      children: 'img',
      pswpModule: () => import('photoswipe'),
      tapAction: 'next',
    });

    // 用图片真实像素尺寸做缩放动画；点击时页面里已渲染，直接读取实际尺寸
    lightbox.addFilter('itemData', (itemData) => {
      const el = itemData.element;
      if (el instanceof HTMLImageElement) {
        itemData.src = el.currentSrc || el.src;
        itemData.width = el.naturalWidth || 1600;
        itemData.height = el.naturalHeight || 1067;
      }
      return itemData;
    });

    lightbox.init();
  });
</script>

<style is:global>
  /*
    .gallery-slider is raw HTML injected by remark at build time, so it never
    receives Astro's scoped data attribute — these rules must be global.

    布局模型：构建期 remark 插件已把本轮播最“瘦”图的比例内联为容器的
    aspect-ratio，浏览器首帧即知容器尺寸。所有 <img> 绝对定位叠放在固定
    画布内、宽度撑满、底部对齐，切换只改 opacity —— 页面其他部分零参与，
    无 CLS；矮图上方留白区域背景透明，露出页面底色（#f8f7f4），无灰边。
  */
  .gallery-slider {
    position: relative;
    width: 100%;
    margin: 3.5rem 0;
    cursor: pointer;
    /* 兜底比例：构建期读不到图比例（如外链图）时使用，正常被内联 style 覆盖 */
    aspect-ratio: 16 / 9;
    background: transparent;
  }
  .gallery-slider img {
    position: absolute;
    left: 0;
    bottom: 0;              /* 底部对齐：矮图贴底，留白统一在上方 */
    width: 100%;
    height: auto;
    margin: 0;              /* 覆盖 .prose img 的 3.5rem 上下边距 */
    background: transparent; /* 覆盖 .prose img 的 #f0efec，留白与页面同色 */
    border-radius: 0;
    opacity: 0;
  }
  .gallery-slider img.is-active {
    opacity: 1;
  }
  .gallery-empty {
    color: var(--c-mid);
    font-style: italic;
  }
</style>
