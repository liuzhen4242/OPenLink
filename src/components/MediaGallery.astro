---
import '../styles/gallery.css';
// Shared client behavior for blog/project article pages:
// gallery slider auto-cycling + PhotoSwipe image lightbox.
import 'photoswipe/style.css';
---

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import PhotoSwipe from 'photoswipe';

  const initMediaGalleries = () => {
    // 等图片真正解码、可绘制后再切换，避免切换瞬间空白/半渲染闪烁
    function whenSettled(img) {
      if (typeof img.decode === 'function') {
        return img.decode().catch(() => {});
      }
      if (img.complete) return Promise.resolve();
      return new Promise((resolve) => {
        img.addEventListener('load', resolve, { once: true });
        img.addEventListener('error', resolve, { once: true });
      });
    }

    document.querySelectorAll('.gallery-slider').forEach((wrapper) => {
      const imgs = Array.from(wrapper.querySelectorAll('img'));
      if (imgs.length === 0) return;
      const interval = Number(wrapper.dataset.interval) || 1000;

      // Gallery 比普通正文图片多取一档像素密度：仍然走压缩 WebP，
      // 但避免相册只选到接近屏幕显示宽度的低分辨率版本。
      imgs.forEach((img) => {
        if (img.srcset) {
          img.sizes = '(min-width: 1344px) 1200px, calc((100vw - 4rem) * 2)';
        }
      });

      if (imgs.length === 1) {
        imgs[0].classList.add('is-active');
        return;
      }

      let index = imgs.findIndex((img) => img.classList.contains('is-active'));
      if (index < 0) index = 0;
      let playing = true;

      function show(i) {
        imgs.forEach((img, j) => img.classList.toggle('is-active', j === i));
      }

      // 每轮只等下一张就绪，上限 8s，慢图/坏图不会卡死轮播
      async function tick() {
        if (playing) {
          const nextIndex = (index + 1) % imgs.length;
          await Promise.race([
            whenSettled(imgs[nextIndex]),
            new Promise((resolve) => window.setTimeout(resolve, 8000)),
          ]);
          if (playing) {
            index = nextIndex;
            show(index);
          }
        }
        window.setTimeout(tick, interval);
      }

      show(index);
      window.setTimeout(tick, interval);

      wrapper.addEventListener('mouseenter', () => {
        playing = false;
      });
      wrapper.addEventListener('mouseleave', () => {
        playing = true;
      });
    });

    const images = Array.from(document.querySelectorAll<HTMLImageElement>('.prose img'));
    if (images.length === 0) return;

    const createDataSource = () => images.map((img) => ({
      element: img,
      // 页面内使用 srcset 小图；PhotoSwipe 使用最大的压缩 WebP，
      // 不加载原始文件，同时保证放大后仍有足够像素。
      src: img.getAttribute('src') || img.src,
      // 在点击瞬间读取，避免懒加载图片初始化时还没有尺寸，
      // 被默认比例 1600×1067 误导而出现轻微压窄。
      width: Number(img.getAttribute('width')) || img.naturalWidth || img.clientWidth || 1600,
      height: Number(img.getAttribute('height')) || img.naturalHeight || img.clientHeight || 1067,
    }));

    const lightbox = new PhotoSwipeLightbox({
      // 静态传入主模块，避免点击时再动态请求 photoswipe.js 失败。
      pswpModule: () => Promise.resolve(PhotoSwipe),
      tapAction: 'next',
    });

    lightbox.init();

    // 明确绑定正文图片点击，避免 Astro 开发模式下 PhotoSwipe 的
    // delegated click listener 因脚本加载时序失效。
    images.forEach((img, index) => {
      img.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        lightbox.loadAndOpen(index, createDataSource());
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMediaGalleries, { once: true });
  } else {
    initMediaGalleries();
  }
</script>
