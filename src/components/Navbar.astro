---
const navLinks = [
  { href: '/projects', label: '项目' },
  { href: '/blog',     label: '博客' },
  { href: '/about',    label: '关于' },
];

const currentPath = Astro.url.pathname;
---

<nav>
  <div class="nav-inner">
    <!-- Wordmark -->
    <a href="/projects" class="wordmark">OPEN<span>LINK</span></a>

    <!-- Nav links -->
    <ul class="nav-links">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['nav-link', { active: currentPath.startsWith(href) }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Full-width hairline rule -->
  <div class="nav-rule"></div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-bg);
    transition: background-color 0.3s ease;
  }

  /* 桌面端：导航白色背景从 OPENLINK 位置开始，左边目录栏上方留空，不遮挡主题按钮 */
  @media (min-width: 1024px) {
    nav {
      background: linear-gradient(
        to right,
        transparent 0,
        transparent calc(
          max(
            calc((100vw - min(100vw, var(--max-w))) / 2 + var(--pad-x)),
            var(--toggle-safe)
          ) + 220px + 3rem
        ),
        var(--c-bg) calc(
          max(
            calc((100vw - min(100vw, var(--max-w))) / 2 + var(--pad-x)),
            var(--toggle-safe)
          ) + 220px + 3rem
        ),
        var(--c-bg) 100%
      );
    }
  }

  .nav-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 2.5rem var(--pad-x) 1.25rem;
    /* 避退：视口左缘空隙小于左上角主题按钮安全区时，连续补足 padding-left，
       wordmark 与按钮保持 ≥12px 间距（与 .site-main 同款公式） */
    padding-left: max(
      var(--pad-x),
      calc(var(--toggle-safe) - (100vw - min(100vw, var(--max-w))) / 2)
    );
  }

  /* 桌面端：详情页默认 OPENLINK 右移，对齐中间正文栏左边界 */
  @media (min-width: 1024px) {
    .nav-inner {
      padding-left: calc(
        max(
          var(--pad-x),
          calc(var(--toggle-safe) - (100vw - min(100vw, var(--max-w))) / 2)
        ) + 220px + 3rem
      );
    }
  }

  .wordmark {
    font-family: var(--ff-caps);
    font-size: 13pt;
    letter-spacing: 0.15em;
    color: var(--c-ink);
  }
  .wordmark span {
    /* subtle weight break between OPEN and LINK */
    font-style: italic;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--ff-serif);
    font-size: var(--fs-sm);
    letter-spacing: 0.06em;
    color: var(--c-mid);
    position: relative;
    padding-bottom: 2px;
    transition: color 0.18s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--c-ink);
    transition: width 0.25s ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--c-ink);
  }
  .nav-link.active::after,
  .nav-link:hover::after {
    width: 100%;
  }

  .nav-rule {
    height: 1px;
    background: var(--c-rule);
    max-width: var(--max-w);
    margin: 0 auto;
  }

  /* 桌面端：详情页默认下划线左右收窄，和正文分隔线同宽 */
  @media (min-width: 1024px) {
    .nav-rule {
      margin-left: calc(
        (100vw - min(100vw, var(--max-w))) / 2 + var(--pad-x) + 220px + 3rem
      );
      margin-right: calc(
        (100vw - min(100vw, var(--max-w))) / 2 + var(--pad-x) + 200px + 3rem
      );
    }
  }

  /* 列表页（项目 / 博客）：导航和下划线直接对齐内容左右，不做详情页三栏偏移 */
  @media (min-width: 1024px) {
    body.page-project-list .nav-inner,
    body.page-list .nav-inner {
      padding-left: max(
        var(--pad-x),
        calc(var(--toggle-safe) - (100vw - min(100vw, var(--max-w))) / 2)
      );
    }
    body.page-project-list .nav-rule,
    body.page-list .nav-rule {
      margin-left: calc((100vw - min(100vw, var(--max-w))) / 2 + var(--pad-x));
      margin-right: calc((100vw - min(100vw, var(--max-w))) / 2 + var(--pad-x));
    }
    body.page-project-list nav,
    body.page-list nav {
      background: var(--c-bg);
    }
  }
</style>
