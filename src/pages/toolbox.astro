---
import { readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * /toolbox — 小工具索引（网格卡片 + 互动缩略图）
 *
 * 扫描 src/content/tool/ 下的 .html 工具；
 * 若存在同名 .js（如 AlignIMG.html ↔ AlignIMG.js），把该 JS 内联为
 * 卡片缩略图上的互动动画（点击动画区域产生互动、不跳转），
 * 卡片下方文字行链接到 /tools/<name> 打开完整工具。
 *
 * 路径用 process.cwd() 锚定项目根：dev 与 build（含 Netlify/双机）下
 * cwd 都是项目根，避免 import.meta.url 在 build 时被解析到 dist/.prerender/content/tool。
 */

const TOOL_DIR = join(process.cwd(), 'src/content/tool');

interface ToolItem {
  name: string;
  title: string;
  href: string;
  hasCover: boolean;
}

const toolFiles = readdirSync(TOOL_DIR);

const tools: ToolItem[] = toolFiles
  .filter((f) => f.endsWith('.html'))
  .map((file) => {
    const name = file.replace(/\.html$/i, '');
    const html = readFileSync(join(TOOL_DIR, file), 'utf-8');
    const m = html.match(/<title[^>]*>([\s\S]*?)<\/title>/i);
    const title = (m ? m[1].trim() : name);
    return {
      name,
      title,
      href: `/tools/${encodeURIComponent(name)}`,
      hasCover: toolFiles.some((f) => f.toLowerCase() === `${name}.js`.toLowerCase()),
    };
  });

// 收集缩略图动画脚本（同名 .js 的内容，内联到页面）。
// 当前每个脚本用固定 id "align-cover-canvas" 查找宿主容器，
// 故每页只挂第一个动画实例；多工具需各自动画时再扩展为 class 遍历。
const coverScripts = tools
  .filter((t) => t.hasCover)
  .map((t) => readFileSync(join(TOOL_DIR, `${t.name}.js`), 'utf-8'));

const coverToolName = tools.find((t) => t.hasCover)?.name ?? '';
---

<BaseLayout title="工具箱" description="小工具与实验 — Tools &amp; Experiments" pageClass="page-list">
  <header class="tools-header">
    <div class="tools-eyebrow">Toolbox</div>
    <h1 class="tools-title">工具箱</h1>
    <p class="tools-sub">小工具与实验 — Small tools and experiments.</p>
  </header>

  {tools.length === 0 ? (
    <p class="empty-state">暂无工具 — 把 HTML 工具文件放入 src/content/tool/ 目录即可自动出现在这里。</p>
  ) : (
    <div class="tool-grid">
      {tools.map((tool) => (
        <div class="tool-card">
          <div class="tool-thumb" id={tool.hasCover ? 'align-cover-canvas' : undefined}>
            {!tool.hasCover && <span class="thumb-placeholder">—</span>}
          </div>
          <div class="tool-meta">
            <span class="tool-cat">Tool</span>
            <span class="tool-sep">·</span>
            <a class="tool-title" href={tool.href}>{tool.title}</a>
          </div>
        </div>
      ))}
    </div>
  )}
</BaseLayout>

{coverScripts.length > 0 && <script is:inline set:html={coverScripts[0]} />}

<style>
  /* ── Page header ─────────────────────────────────── */
  .tools-header {
    padding: 4rem 0 3rem;
    margin-bottom: 3rem;
  }
  .tools-eyebrow {
    font-family: var(--ff-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.18em;
    color: var(--c-mid);
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }
  .tools-title {
    font-family: var(--ff-caps);
    font-size: 28pt;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--c-ink);
    margin: 0;
    line-height: 1.1;
  }
  .tools-sub {
    font-family: var(--ff-serif);
    color: var(--c-mid);
    margin-top: 0.8rem;
    font-size: var(--fs-sm);
  }

  /* ── Grid（与 /projects 同款两列网格） ─────────── */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 2.5rem;
  }

  .tool-card {
    display: block;
  }

  /* 缩略图：正方形画布，保持互动动画 1:1 比例不变形 */
  .tool-thumb {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #0a0a0c; /* 与动画画布底色一致，避免白闪 */
    cursor: pointer;
  }
  .tool-thumb canvas {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  .thumb-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--c-mid);
    font-size: 1.5rem;
  }

  /* 文字行：点击跳转工具页 */
  .tool-meta {
    margin-top: 0.6rem;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.3rem;
    font-family: var(--ff-serif);
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    color: var(--c-mid);
    line-height: var(--lh-tight);
  }
  .tool-cat {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 6.5pt;
  }
  .tool-sep { color: var(--c-rule); }
  .tool-title {
    color: var(--c-ink);
    font-size: 9pt;
    font-weight: 500;
    flex: 1;
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .tool-title:hover {
    color: var(--c-mid);
  }

  .empty-state {
    margin-top: 4rem;
    font-size: var(--fs-sm);
    color: var(--c-mid);
    font-style: italic;
  }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 640px) {
    .tool-grid { grid-template-columns: 1fr; }
    .tools-title { font-size: 20pt; }
  }
</style>
