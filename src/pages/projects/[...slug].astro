---
/**
 * /projects/[...slug] — Project detail page
 *
 * In Astro v7 Content Layer API, entries use `id` (the file path relative to
 * the glob base, e.g. "Projects/Xinjiang-museum/Xinjiang-museum.md") instead
 * of the legacy `slug`.
 *
 * We derive:
 * • URL slug:      "Projects/Xinjiang-museum/Xinjiang-museum"  (no .md)
 * • Project dir:   "Projects/Xinjiang-museum"                  (directory)
 * • Image base:    /project-images/<projectDir>/images/  (static, works
 *   identically in `astro dev`, `astro build`, and on Netlify — populated
 *   by scripts/sync-project-images.mjs, which runs automatically before
 *   both `npm run dev` and `npm run build`)
 *
 * Features:
 * • Full-width architectural drawings (margin: 3.5rem 0 via .prose img rule)
 * • Runtime image rewriting: body <img> src attrs → /project-images/ paths
 * • Gallery slider + PhotoSwipe lightbox (shared MediaGallery component)
 *
 * NOTE: the frontmatter `coverImage` is intentionally NOT rendered on this
 * page — it's only used as the thumbnail on the /projects listing page
 * (see src/pages/projects/index.astro). The detail page goes straight from
 * the header into the article body.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaGallery from '../../components/MediaGallery.astro';

/** Convert entry id → URL slug (strip .md extension and leading Projects/) */
function idToSlug(id: string): string {
  return id.replace(/\.md$/, '').replace(/^[Pp]rojects\//, '');
}

/** Extract the project directory from entry id */
function idToProjectDir(id: string): string {
  const parts = id.replace(/\.md$/, '').split('/');
  parts.pop();
  return parts.join('/');
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => {
    // Convert entry id → URL slug (strip .md extension and leading Projects/)
    const slug = project.id.replace(/\.md$/, '').replace(/^[Pp]rojects\//, '');
    return {
      params: { slug },
      props:  { project },
    };
  });
}

const { project } = Astro.props;
const { data } = project;

const { Content, headings } = await render(project);

const projectDir = idToProjectDir(project.id);

/**
 * Build a nested outline from the flat `headings` array Astro's render()
 * gives us — h3 (### in the source note) becomes a top-level item, and any
 * h4 immediately following is nested under it. Mirrors the outline you'd
 * see in Obsidian's own sidebar. h1/h2 and anything deeper than h4 is
 * ignored to keep the sidebar readable.
 */
const tocItems: { slug: string; text: string; children: { slug: string; text: string }[] }[] = [];
for (const heading of headings) {
  if (heading.depth === 3) {
    tocItems.push({ slug: heading.slug, text: heading.text, children: [] });
  } else if (heading.depth === 4 && tocItems.length > 0) {
    tocItems[tocItems.length - 1].children.push({ slug: heading.slug, text: heading.text });
  }
}
---

<BaseLayout title={data.title} description={data.description}>

  <div class="project-layout">
    <div class="project-main">
      <!-- ── Project header ─────────────────────────────── -->
      <header class="project-header">
        <div class="project-super">
          <span class="project-category">{data.category.join(' / ')}</span>
          {data.date && <span class="project-date">{data.date}</span>}
        </div>
        <h1 class="project-title">{data.name}</h1>
        <p class="project-title-en">{data.title}</p>
        {data.description && (
          <p class="project-desc">{data.description}</p>
        )}
      </header>

      <!-- ── Markdown body (drawings, prose) ────────────── -->
      <article class="prose">
        <Content />
      </article>

      <!-- Back link -->
      <nav class="back-nav">
        <a href="/projects" class="back-link">
          <span aria-hidden="true">←</span>&ensp;所有项目
        </a>
      </nav>
    </div>

    {tocItems.length > 0 && (
      <aside class="project-toc">
        <h2 class="toc-label" data-toc-top>{data.title}</h2>


        <nav>
          <ul class="toc-list">
            {tocItems.map((item) => (
              <li class="toc-item">
                <a
                  href={`#${item.slug}`}
                  class="toc-parent"
                  {...(item.children.length > 0 ? { 'data-toc-parent': item.slug } : {})}
                  data-toc-link={item.slug}
                >
                  {item.text}
                </a>

                {item.children.length > 0 && (
                  <ul
                    class="toc-sublist collapsed"
                    data-toc-sublist={item.slug}
                  >
                    {item.children.map((child) => (
                      <li>
                        <a
                          href={`#${child.slug}`}
                          data-toc-link={child.slug}
                        >
                          {child.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>


      </aside>
    )}
  </div>
  <MediaGallery />
</BaseLayout>



<!--
  Rewrite relative Obsidian image src attributes at runtime, as a safety
  net for any <img> tags that reach the browser with a bare/unrewritten
  relative path. Points at /project-images/, a plain static folder that
  scripts/sync-project-images.mjs populates from src/content/projects/*/images
  before both `npm run dev` and `npm run build` — this works identically
  in local dev, `astro preview`, and on Netlify.
-->
<script define:vars={{ projectDir }}>
  document.addEventListener('DOMContentLoaded', () => {
    const prose = document.querySelector('.prose');
    if (!prose) return;

    // Mark paragraphs that mix an image with following text (e.g.
    // "<img>老旧厂房升级更新</p>") so CSS can pull the text closer to the
    // image above it. Pure CSS can't tell an img-only paragraph apart from
    // one with trailing text, hence the class.
    prose.querySelectorAll('p').forEach((p) => {
      if (p.querySelector('img') && p.textContent.trim().length > 0) {
        p.classList.add('has-caption');
      }
    });

    prose.querySelectorAll('img').forEach((img) => {
      const src = img.getAttribute('src') || '';
      // Skip external URLs, data URIs, and paths already rewritten to /project-images/
      if (src.startsWith('http') || src.startsWith('data:') || src.startsWith('/project-images/')) return;
      const raw = decodeURIComponent(src);
      const filename = raw.split('/').pop() || raw;
      if (!filename) return;
      img.src = `/project-images/${projectDir}/images/${encodeURIComponent(filename)}`;
    });
  });
</script>

<script>
document.addEventListener('DOMContentLoaded', () => {

  // 点击侧边栏顶部 title 平滑回到页面顶部
  const tocLabel = document.querySelector('.toc-label');
  if (tocLabel) {
    tocLabel.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // 初始化：折叠状态的子列表，对应箭头初始旋转90度
  document.querySelectorAll('.toc-sublist.collapsed').forEach(sublist => {
    const slug = sublist.dataset.tocSublist;
    const parent = document.querySelector(`[data-toc-parent="${slug}"]`);
    if (parent) {
      parent.style.setProperty('--arrow-rotate', '90deg');
    }
  });

  // 滚动高亮：当前章节对应的导航项变黑，顶部标题变灰
  const tocLinks = document.querySelectorAll('[data-toc-link]');
  const headings = document.querySelectorAll('.prose h2, .prose h3, .prose h4');

  if (headings.length === 0) return;

  const setActive = (slug) => {
    tocLinks.forEach(link => {
      link.classList.toggle('active', link.dataset.tocLink === slug);
    });
    // 有章节激活时，顶部标题变灰
    if (tocLabel) tocLabel.classList.add('inactive');
  };

  // 点击任意导航项立刻高亮，同时处理折叠展开
  tocLinks.forEach(link => {
    link.addEventListener('click', () => {
      // 立刻设置激活状态
      const slug = link.dataset.tocLink;
      if (slug) setActive(slug);

      // 如果是有子项的父级，切换折叠
      const parentSlug = link.dataset.tocParent;
      if (parentSlug) {
        const sublist = document.querySelector(`[data-toc-sublist="${parentSlug}"]`);
        if (sublist) {
          sublist.classList.toggle('collapsed');
          link.style.setProperty('--arrow-rotate',
            sublist.classList.contains('collapsed') ? '90deg' : '0deg'
          );
        }
      }
    });
  });

  const observer = new IntersectionObserver((entries) => {
    const visible = entries
      .filter(entry => entry.isIntersecting)
      .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
    if (visible.length > 0) {
      const slug = visible[0].target.id;
      setActive(slug);
    }
  }, {
    rootMargin: '-80px 0px -70% 0px',
    threshold: 0
  });

  headings.forEach(h => observer.observe(h));

  // 页面滚动到顶部区域（还没进入正文）时，清除高亮，顶部标题变黑
  const onScroll = () => {
    const scrollY = window.scrollY;
    // 滚动到文章标题下方约 200px 以内，认为是页面顶部
    if (scrollY < 300) {
      if (tocLabel) tocLabel.classList.remove('inactive');
      tocLinks.forEach(link => link.classList.remove('active'));
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // 初始化

});
</script>




<style>
  /* ── Two-column layout: article + outline sidebar ─── */
  .project-layout {
    display: flex;
    align-items: flex-start;
    gap: 4rem;
  }
  .project-main {
    flex: 1;
    min-width: 0;
  }

  /* ── Project header ──────────────────────────────── */
  .project-header {
    padding: 4rem 0 2.5rem;
    border-bottom: 1px solid var(--c-rule);
    margin-bottom: 0;
  }
  .project-super {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .project-category {
    font-family: var(--ff-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-mid);
  }
  .project-date {
    font-family: var(--ff-serif);
    font-size: var(--fs-xs);
    color: var(--c-mid);
    font-variant-numeric: tabular-nums;
  }
  .project-date::before {
    content: '—';
    margin-right: 0.5em;
    color: var(--c-rule);
  }

  .project-title {
    font-family: var(--ff-caps);
    font-size: 22pt;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--c-ink);
    margin: 0 0 0.25rem;
    line-height: 1.2;
  }
  .project-title-en {
    font-family: var(--ff-serif);
    font-size: var(--fs-sm);
    color: var(--c-mid);
    margin: 0 0 0.75rem;
    font-style: italic;
  }
  .project-desc {
    font-family: var(--ff-serif);
    font-size: var(--fs-sm);
    color: var(--c-mid);
    margin: 0;
    font-style: italic;
  }

  /* ── Prose: full-width drawings ──────────────────── */
  .prose { max-width: none; }
  :global(.prose img) {
    cursor: zoom-in;
  }

  /* ── Back navigation ──────────────────────────────── */
  .back-nav {
    margin-top: 6rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-rule);
  }
  .back-link {
    font-family: var(--ff-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-mid);
    transition: color 0.18s ease;
  }
  .back-link:hover { color: var(--c-ink); }

  /* ── Outline sidebar ──────────────────────────────── */
  .project-toc {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 6rem;
    padding-top: 4rem; /* roughly align with the article header */
  }
  .toc-label {
    font-family: 'PingFang SC', 'Hiragino Sans GB', 'Heiti SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif;
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--c-ink);
    margin: 0 0 1.25rem;
    cursor: pointer;
    transition: color 0.18s ease;
  }
  .toc-label.inactive {
    color: #a8a8a8;
  }
  .toc-list, .toc-sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-list > li {
    margin-bottom: 0.5rem;
  }

  .toc-list a {
    display: block;
    font-family: var(--ff-serif);
    font-size: var(--fs-sm);
    color: #a8a8a8;
    padding: 0.15rem 0;
    transition: color 0.18s ease;
  }

  .toc-parent {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* 父级标题前的小三角箭头，Obsidian 风格 */
  .toc-parent::before {
    content: '▾';
    display: inline-block;
    font-size: 0.75em;
    transition: transform 0.15s ease;
    color: #a8a8a8;
    flex-shrink: 0;
    width: 0.8em;
    text-align: center;
    transform: rotate(var(--arrow-rotate, 0deg));
  }
  /* 没有子项的父级不显示箭头 */
  .toc-parent:not([data-toc-parent])::before {
    display: none;
  }

  .toc-list a:hover { color: var(--c-ink); }
  .toc-list a.active {
    color: var(--c-ink);
    font-weight: 500;
  }

  .toc-sublist {
    margin-left: 1.1rem;
    margin-top: 0.25rem;
    overflow: hidden;
    max-height: 500px;
    opacity: 1;
    transition:
      max-height 0.2s ease,
      opacity 0.2s ease;
  }

  .toc-sublist.collapsed {
    max-height: 0;
    opacity: 0;
  }

  .toc-sublist a {
    font-size: var(--fs-xs);
  }

  @media (max-width: 900px) {
    .project-toc { display: none; }
  }
</style>
