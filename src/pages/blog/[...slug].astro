---
/**
 * /blog/[...slug] — Individual blog post page.
 *
 * The blog index (/blog) already links to /blog/<slug>; this page makes
 * those links resolve. Slug = the markdown filename without .md, matching
 * the hrefs generated in blog.astro.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaGallery from '../../components/MediaGallery.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.flatMap((post) => {
    const slug = post.id.replace(/\.md$/, '');
    const status = post.data.status;
    // 线上：hidden 彻底不生成页面（网上不可见）；本地 dev 正常显示，方便自己查看。
    if (import.meta.env.PROD && status === 'hidden') return [];
    // 线上：private 生成到 /blog/private/<slug>，由 public/_headers 的 Basic Auth 密码保护；
    // 本地 dev：直接放 /blog/<slug>，自己查看不设密码。
    const routeSlug = import.meta.env.PROD && status === 'private' ? `private/${slug}` : slug;
    return [{ params: { slug: routeSlug }, props: { post } }];
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <!-- ── Post header ───────────────────────────────── -->
  <header class="post-header">
    <div class="post-super">
      <span class="post-category">{post.data.category.join(' / ')}</span>
      {post.data.date && <span class="post-date">{post.data.date}</span>}
    </div>
    <h1 class="post-title">{post.data.title}</h1>
    {post.data.description && <p class="post-desc">{post.data.description}</p>}
  </header>

  <!-- ── Markdown body ─────────────────────────────── -->
  <article class="prose post-body">
    <Content />
  </article>

  <!-- Back link -->
  <nav class="back-nav">
    <a href="/blog" class="back-link">
      <span aria-hidden="true">←</span>&ensp;全部文章
    </a>
  </nav>
  <MediaGallery />
</BaseLayout>

<style>
  .post-header {
    padding: 4rem 0 2.5rem;
    border-bottom: 1px solid var(--c-rule);
    max-width: 46rem;
  }
  .post-super {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
  }
  .post-category {
    font-family: var(--ff-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-mid);
  }
  .post-date {
    font-family: var(--ff-serif);
    font-size: var(--fs-xs);
    color: var(--c-mid);
    font-variant-numeric: tabular-nums;
  }
  .post-date::before {
    content: '—';
    margin-right: 0.5em;
    color: var(--c-rule);
  }
  .post-title {
    font-family: var(--ff-caps);
    font-size: 22pt;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--c-ink);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }
  .post-desc {
    font-family: var(--ff-serif);
    font-size: var(--fs-sm);
    color: var(--c-mid);
    margin: 0;
    font-style: italic;
  }

  .post-body {
    max-width: 46rem;
    padding-top: 2.5rem;
  }

  .back-nav {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--c-rule);
    max-width: 46rem;
  }
  .back-link {
    font-family: var(--ff-caps);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-mid);
    transition: color 0.18s ease;
  }
  .back-link:hover { color: var(--c-ink); }
</style>
